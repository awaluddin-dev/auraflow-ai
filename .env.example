# LLM Providers — isi minimal satu
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=

# Custom OpenAI-compatible endpoint (Ollama, OpenRouter, vLLM)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=llama3.2

# Provider fallback order
LLM_PROVIDER_ORDER=gemini,groq,openai,claude,azure_openai,custom

# Model overrides (opsional)
GEMINI_MODEL=gemini-3.6-flash
GROQ_MODEL=openai/gpt-oss-20b
OPENAI_MODEL=gpt-4o-mini
CLAUDE_MODEL=claude-haiku-4-5-20251001
AZURE_OPENAI_MODEL=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-02-01

# Database
AURAFLOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/auraflow?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Gateway
PORT=3000
QUEUE_NAME=auraflow-jobs
GATEWAY_CALLBACK_URL=http://localhost:3000/jobs/callback

# Worker tuning
MAX_PARSE_ATTEMPTS=3
CALLBACK_MAX_RETRIES=5
CALLBACK_BASE_DELAY_SECONDS=1.0
CALLBACK_MAX_DELAY_SECONDS=30.0